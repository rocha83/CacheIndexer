<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<LangVersion>9.0</LangVersion>
		<Nullable>disable</Nullable>
		<Copyright>Renato Rocha</Copyright>
		<Authors>Renato Rocha</Authors>
		<Company></Company>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<RepositoryType>Git</RepositoryType>
		<RepositoryUrl>https://github.com/rocha83/CacheIndexer</RepositoryUrl>
		<PackageProjectUrl>https://github.com/rocha83/CacheIndexer</PackageProjectUrl>
		<PackageTags>cache indexer lexical index inverted index search stemming soundex synonyms pt-br</PackageTags>
		<Version>1.0.0</Version>
		<Description>In-memory lexical cache indexer with optional PT-BR stemming (Porter), phonetic (Soundex PT-BR) and synonym dictionary expansion.</Description>
		<PackageLicenseFile>GNUv2_License.txt</PackageLicenseFile>
		<PackageIcon>cache-indexer-logo.png</PackageIcon>
	</PropertyGroup>

	<ItemGroup>
	  <None Remove="Resources\pt_br_synonyms.json" />
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Include="Resources\pt_br_synonyms.json">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Rochas.Extensions" Version="1.2.6" />
		<PackageReference Include="Rochas.PTStemmer" Version="1.0.2" />
		<PackageReference Include="System.Text.Json" Version="10.0.8" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="GNUv2_License.txt">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	  <None Update="cache-indexer-logo.png">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

</Project>
