<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<LangVersion>9.0</LangVersion>
		<Nullable>disable</Nullable>
		<Copyright>Renato Rocha</Copyright>
		<Authors>Renato Rocha</Authors>
		<Company></Company>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<RepositoryType>Git</RepositoryType>
		<RepositoryUrl>https://github.com/rocha83/CacheIndexer</RepositoryUrl>
		<PackageProjectUrl>https://github.com/rocha83/CacheIndexer</PackageProjectUrl>
		<PackageTags>cache indexer lexical index inverted index search stemming soundex synonyms pt-br cache provider distributed cache redis garnet background worker persistence</PackageTags>
		<Version>2.0.0</Version>
		<Description>In-memory lexical cache indexer with optional PT-BR stemming (Porter), phonetic (Soundex PT-BR), synonym dictionary expansion and pluggable cache providers (in-memory, distributed Redis/Garnet, composite, persistence channel). Includes a Background Service worker (PersistenceChannelWorker&lt;T&gt;) + DataDispatcher&lt;T&gt; for automatic replication to a DB via IPersistenceRepository&lt;T&gt;.</Description>
		<PackageReleaseNotes>2.0.0 - (data-toolkit) contract dependency migrated to Rochas.Data.Specification 2.0.0; DataDispatcher&lt;T&gt; now consumes the base contract IPersistenceRepository&lt;T&gt; (Add/Remove). 1.2.6 - PersistenceChannelWorker&lt;T&gt; (Background Service) + DataDispatcher&lt;T&gt; replicando o canal de persistencia em banco via IGenericRepository&lt;T&gt;. 1.1.4 - BREAKING: removido sufixo "Async" (EnsureIndexLoaded, FindBestMatch, Consume); DataCache.Initialize(memorySizeLimit); modulo de cache de objetos (ICacheProvider, InMemoryCacheProvider, DistributedCacheProvider Redis/Garnet, CompositeCacheProvider L1+L2, PersistenceChannelCacheProvider com fan-out via Subscribe); namespace Rochas.CacheIndexer.Providers. 1.0.0 - indice lexico invertido com stemming PT-BR, soundex e sinonimos; ranking por cobertura + IDF.</PackageReleaseNotes>
		<PackageLicenseFile>GNUv2_License.txt</PackageLicenseFile>
		<PackageIcon>cache-indexer-logo.png</PackageIcon>
	</PropertyGroup>

	<ItemGroup>
	  <None Remove="Resources\pt_br_synonyms.json" />
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Include="Resources\pt_br_synonyms.json">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="9.0.0" />
		<PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="9.0.0" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.0" />
		<PackageReference Include="Rochas.Data.Specification" Version="2.0.0" />
		<PackageReference Include="Rochas.Extensions" Version="1.2.6" />
		<PackageReference Include="Rochas.PTStemmer" Version="1.0.2" />
		<PackageReference Include="System.Text.Json" Version="10.0.8" />
		<PackageReference Include="System.Threading.Channels" Version="9.0.0" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="GNUv2_License.txt">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	  <None Update="cache-indexer-logo.png">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

</Project>
